{
  "name": "ycore-music-desktop",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "desktop": "tauri dev",
    "test:ui": "playwright test",
    "package:windows": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "package:linux": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles deb,appimage",
    "package:macos": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles app,dmg",
    "bundle:windows:debug": "tauri bundle --debug --config src-tauri/tauri.bundle.conf.json --bundles nsis"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/youtube": "^0.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
