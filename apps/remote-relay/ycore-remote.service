[Unit]
Description=YCore Music phone remote relay
After=network.target

[Service]
Type=simple
DynamicUser=true
ExecStart=/opt/ycore-runtime/current/bin/node /opt/ycore-remote/current/apps/remote-relay/server.mjs
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
